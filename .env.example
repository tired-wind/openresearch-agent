# Local defaults. Copy to .env; never commit actual values.
OPENRESEARCH_DATA_DIR=data
# The original workspace executes deterministic tools. /agent uses loopback Ollama
# with the preinstalled qwen3.5:4b model; it does not use this legacy switch.
OPENRESEARCH_LLM_PROVIDER=disabled

# ---------------------------------------------------------------------------
# DATA layer: Zetaris (local Docker deployment)
# ---------------------------------------------------------------------------
# Direct REST base. A local install serves the platform API on port 8888.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Numeric organisation ID from Management -> Organisation (not the name or slug).
ZETARIS_ORG_ID=1
# Created in the UI under Management -> API Tokens. Shown once; keep it only here.
ZETARIS_API_KEY=
# Web UI origin, used by the UI-proxy helpers.
ZETARIS_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# POWER layer: Meterless Nightshift serving NVIDIA Nemotron
# ---------------------------------------------------------------------------
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Runtime access token from Nightshift's Console. This is not the NVIDIA key.
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Pin a Nemotron-backed model when the NVIDIA award evidence must be unambiguous.
NEMOTRON_MODEL=

# The NVIDIA key itself belongs inside Nightshift's Providers tab, never in this file.
